  <rdf:Description rdf:about="http://ontorisk.example.org/ontology#RiskEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">RiskEvent</rdfs:label>
    <rdfs:comment xml:lang="en">A business-risk occurrence detected in text, e.g. a flood disrupting a warehouse.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://ontorisk.example.org/ontology#Entity"/>
    <owl:disjointWith rdf:resource="http://ontorisk.example.org/ontology#Location"/>
    <owl:disjointWith rdf:resource="http://ontorisk.example.org/ontology#RiskType"/>
    <owl:disjointWith rdf:resource="http://ontorisk.example.org/ontology#SourceArticle"/>
    <owl:disjointWith rdf:resource="http://ontorisk.example.org/ontology#RiskTerm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://ontorisk.example.org/ontology#Term_truckers__strike">
