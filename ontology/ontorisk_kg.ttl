<http://ontorisk.example.org/ontology> a owl:Ontology ;
    rdfs:label "OntoRisk BI domain risk ontology"@en ;
    dcterms:description "Compact ontology for business-risk intelligence: six classes, two object properties." ;
    owl:versionInfo "1.0" .

ork:RiskType_logistics a ork:RiskType,
        owl:NamedIndividual ;
    rdfs:label "logistics"@en ;
    rdfs:comment "Port congestion / transport disruption"@en .

ork:RiskType_policy a ork:RiskType,
        owl:NamedIndividual ;
    rdfs:label "policy"@en ;
    rdfs:comment "Regulatory / policy change"@en .

ork:RiskType_reputational a ork:RiskType,
        owl:NamedIndividual ;
    rdfs:label "reputational"@en ;
    rdfs:comment "Brand / reputational incident"@en .

ork:RiskType_supplier a ork:RiskType,
        owl:NamedIndividual ;
    rdfs:label "supplier"@en ;
    rdfs:comment "Supplier failure / input shortage"@en .

ork:RiskType_weather a ork:RiskType,
        owl:NamedIndividual ;
    rdfs:label "weather"@en ;
    rdfs:comment "Monsoon / natural disaster"@en .

ork:Term_anti_dumping_duty a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "policy" ;
    ork:termLabel "anti-dumping duty" ;
    ork:termWeight 2 .

ork:Term_berthing_delays a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "logistics" ;
    ork:termLabel "berthing delays" ;
    ork:termWeight 2 .

ork:Term_cargo_pile_up a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "logistics" ;
    ork:termLabel "cargo pile-up" ;
    ork:termWeight 2 .

ork:Term_chip_shortage a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "supplier" ;
    ork:termLabel "chip shortage" ;
    ork:termWeight 2 .

ork:Term_cloudburst a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "weather" ;
    ork:termLabel "cloudburst" ;
    ork:termWeight 3 .

ork:Term_component_shortage a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "supplier" ;
    ork:termLabel "component shortage" ;
    ork:termWeight 2 .

ork:Term_congestion a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "logistics" ;
    ork:termLabel "congestion" ;
    ork:termWeight 2 .

ork:Term_consumer_boycott a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "reputational" ;
    ork:termLabel "consumer boycott" ;
    ork:termWeight 2 .

ork:Term_container_shortage a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "logistics" ;
    ork:termLabel "container shortage" ;
    ork:termWeight 2 .

ork:Term_customer_complaints a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "reputational" ;
    ork:termLabel "customer complaints" ;
    ork:termWeight 1 .

ork:Term_cyclone a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "weather" ;
    ork:termLabel "cyclone" ;
    ork:termWeight 3 .

ork:Term_data_breach a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "reputational" ;
    ork:termLabel "data breach" ;
    ork:termWeight 3 .

ork:Term_drought a ork:RiskTerm,
        owl:NamedIndividual ;
    ork:signalsCategory "weather" ;
    ork:termLabel "drought" ;
    ork:termWeight 2 .

ork:Term_dwell_time a ork:RiskTerm,
