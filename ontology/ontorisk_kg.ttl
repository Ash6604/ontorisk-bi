ork:affects a owl:ObjectProperty ;
    rdfs:label "affects"@en ;
    rdfs:comment "The entity is affected by (exposed to) the risk event."@en ;
    rdfs:domain ork:Entity ;
    rdfs:range ork:RiskEvent .

ork:country a owl:DatatypeProperty ;
    rdfs:comment "Country."@en ;
    rdfs:domain ork:Location ;
    rdfs:range xsd:string .

ork:entityName a owl:DatatypeProperty ;
    rdfs:comment "Normalised organisation name."@en ;
    rdfs:domain ork:Entity ;
    rdfs:range xsd:string .

ork:eventDate a owl:DatatypeProperty ;
    rdfs:comment "Publication date of the source article."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:date .

ork:eventId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Shared identifier linking the event to its warehouse fact row."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:string .

ork:headline a owl:DatatypeProperty ;
    rdfs:comment "Article headline."@en ;
    rdfs:domain ork:SourceArticle ;
    rdfs:range xsd:string .

ork:impactScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Impact score on a 0-10 scale."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:decimal .

ork:locatedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "locatedIn"@en ;
    rdfs:comment "The risk event takes place in the location."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range ork:Location .

ork:matchedTerm a owl:DatatypeProperty ;
    rdfs:comment "Vocabulary term that triggered the event."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:string .

ork:mentionCount a owl:DatatypeProperty ;
    rdfs:comment "Number of risk-vocabulary mentions of this type in the article."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:integer .

ork:placeName a owl:DatatypeProperty ;
    rdfs:comment "Normalised place name."@en ;
    rdfs:domain ork:Location ;
    rdfs:range xsd:string .

ork:publisher a owl:DatatypeProperty ;
    rdfs:comment "Article source / publisher."@en ;
    rdfs:domain ork:SourceArticle ;
    rdfs:range xsd:string .

ork:region a owl:DatatypeProperty ;
    rdfs:comment "Indian region (West, South, ...) or International."@en ;
    rdfs:domain ork:Location ;
    rdfs:range xsd:string .

ork:riskCategory a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Name of the RiskType individual for the event."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:string .

ork:sector a owl:DatatypeProperty ;
    rdfs:comment "Business sector assigned to the entity in the article."@en ;
    rdfs:domain ork:Entity ;
    rdfs:range xsd:string .

ork:severityBand a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Low / Medium / High band derived from the impact score."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:string .

ork:signalsCategory a owl:DatatypeProperty ;
    rdfs:comment "Risk type the term signals."@en ;
    rdfs:domain ork:RiskTerm ;
    rdfs:range xsd:string .

ork:sourceId a owl:DatatypeProperty ;
    rdfs:comment "Identifier of the source article (provenance as a property)."@en ;
    rdfs:domain ork:RiskEvent ;
    rdfs:range xsd:string .

ork:state a owl:DatatypeProperty ;
    rdfs:comment "State / province."@en ;
    rdfs:domain ork:Location ;
    rdfs:range xsd:string .

ork:termLabel a owl:DatatypeProperty ;
    rdfs:comment "Surface form of the vocabulary term."@en ;
    rdfs:domain ork:RiskTerm ;
    rdfs:range xsd:string .

ork:termWeight a owl:DatatypeProperty ;
    rdfs:comment "Weight (1-3) of the term in impact scoring."@en ;
    rdfs:domain ork:RiskTerm ;
    rdfs:range xsd:integer .

